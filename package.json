{
  "name": "command-center-desktop",
  "version": "1.0.0",
  "description": "Command Center desktop app",
  "author": "Opsis CX",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.opsiscx.commandcenter",
    "productName": "Command Center",
    "directories": { "output": "dist" },
    "files": ["main.js"],
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
