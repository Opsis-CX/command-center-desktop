{
  "name": "command-center-desktop",
  "version": "1.0.0",
  "description": "Command Center desktop app",
  "author": "Opsis CX",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.opsiscx.commandcenter",
    "productName": "Command Center",
    "directories": { "output": "dist", "buildResources": "." },
    "files": ["main.js"],
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity", "icon": "icon.png" },
   "win": { "target": ["nsis"], "icon": "icon.ico" }
  }
}
